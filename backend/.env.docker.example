# Used by docker-compose.yml (self-hosted deployment, e.g. on a Raspberry Pi).
# Copy to `.env` next to docker-compose.yml - docker compose reads it automatically.
# This file is gitignored; never commit the real one.

POSTGRES_PASSWORD=change-me-to-a-real-password

# The origins allowed to call this API - your Netlify site(s).
ALLOWED_ORIGINS=https://demo-temperature.netlify.app,https://deploy-preview-3--demo-temperature.netlify.app

# Optional - leave blank to run without the AI assistant feature.
ANTHROPIC_API_KEY=
