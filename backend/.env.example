# Postgres connection string (SQLAlchemy + psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sensor_dashboard

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

APP_ENV=development

# Used by later phases (LangGraph agent) - not required for Phase 0
ANTHROPIC_API_KEY=
