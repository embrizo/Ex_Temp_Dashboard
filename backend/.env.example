# Postgres connection string (SQLAlchemy + psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sensor_dashboard

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

APP_ENV=development

# Powers POST /assistant (LangGraph agent). Without this set, /assistant
# returns 503 rather than failing - everything else works fine without it.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5
